# Server-only values. Never prefix privileged credentials with NEXT_PUBLIC_.
# Development fallback is http://localhost:3000. Set your real HTTPS origin
# before production build AND runtime; do not include a path or trailing query.
SITE_URL=http://localhost:3000

# Dedicated development/test Supabase project. Fill these locally, not in Git.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Random secret, at least 32 characters; shared by all instances.
# Used to HMAC submission/email/IP fingerprints. Generate locally; never commit it.
INQUIRY_HASH_SECRET=

# Optional single-IP header, ONLY if your trusted proxy overwrites it and the
# application cannot be reached directly. Comma-separated IP chains are rejected.
# Leave blank until your hosting trust boundary is verified.
INQUIRY_TRUSTED_IP_HEADER=

# Phase 3: browser-safe publishable key (or legacy anon key) from the SAME project.
# Used only on the server in this implementation. NEVER use a secret/service_role key.
SUPABASE_PUBLISHABLE_KEY=
